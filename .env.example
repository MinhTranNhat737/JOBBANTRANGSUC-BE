# ── PostgreSQL Database ──────────────────────────────────
# Khi deploy lên Heroku, Heroku Postgres sẽ tự động cấp biến DATABASE_URL:
# DATABASE_URL=postgres://user:password@host:port/database
# Khi chạy ở máy Local, hệ thống tự động fallback dùng các biến bên dưới:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=BANPHUKIEN

